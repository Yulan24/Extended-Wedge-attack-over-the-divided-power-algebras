function bcf(n1,n2,m,d1,d2)
	a:=0;
	a:=&+[(-1)^i*Binomial(m,i)*Binomial(n1+d1-2*i,n1)*Binomial(n2+d2-2*i,n2):i in [0..Minimum([m,d1 div 2,d2 div 2])]];
	return a;
end function;

function WCExact(d,n)
	if n eq 1 then
		return [[d]];
	end if;
	S:=[];
	for i in [d..0 by -1] do
		for t in WCExact(d-i,n-1) do
			Append(~S,[i] cat t);
		end for;
	end for;
	return S;
end function;

function WC(d1,d2,n1,n2)
	if d1 lt 0 or d2 lt 0 then
		return [];
	end if;
	S:=[];
	for total in [0..d1+d2] do
		for iTotal in [Minimum(d1,total)..Maximum(0,total-d2) by -1] do
			jTotal:=total-iTotal;
			for A in WCExact(iTotal,n1) do
				for B in WCExact(jTotal,n2) do
					Append(~S,A cat B);
				end for;
			end for;
		end for;
	end for;
	return S;
end function;

function BM(R,n1,n2,d1,d2)
    m:=[];
	for A in WC(d1,d2,n1,n2) do
		u:=R!1;
		for i in [1..n1] do
			u*:=R.i^A[i];
        end for;
		for i in [1..n2] do
			u*:=R.(n1+i)^A[n1+i];
		end for;
		Append(~m,u);
    end for;
    return m;
end function;

function mac(H,n1,n2,d1,d2)
	R:=Parent(H[1]);
    F:=BaseRing(R);
    Col:=BM(R,n1,n2,d1,d2);
    Row:=BM(R,n1,n2,d1-2,d2-2);
	M:=[[MonomialCoefficient(v*f,u):u in Col]:f in H,v in Row];
    return Matrix(M);
end function;

function qrlp(f,n)
	R:=Parent(f);
    F:=BaseRing(R);
	M:=CompanionMatrix(f);
	a:=Degree(f);
	C:=[0:i in [1..a]];
	C[a]:=F!1;
	C:=Matrix(F,1,a,C);
	if n lt a then
		return C[1,n+1];
	end if;
	D:=C*M^(n-a+1);
	return D[1,a];
end function;

function qrmat(f,n)
	R:=Parent(f);
	F:=BaseRing(R);
	a:=Degree(f);
	W:=Matrix(F,a,a,[qrlp(f,i+j-2):i in [1..a],j in [1..a]]);
	return W*Transpose(CompanionMatrix(f))^n;
end function;

function qrpk(n,v,d,m,p,seed)
	SetSeed(seed);
	F:=GF(p);
	f:=RandomIrreduciblePolynomial(F,d);
	R:=PolynomialRing(F,n+d);
	o:=n-v;

	S:=[VerticalJoin(HorizontalJoin(ZeroMatrix(F,v),RandomMatrix(F,v,o)),HorizontalJoin(ZeroMatrix(F,o,v),ZeroMatrix(F,o))):i in [1..d]];
	S[1]+:=IdentityMatrix(F,n);

	Q:=[[VerticalJoin(HorizontalJoin(RandomMatrix(F,v,v),RandomMatrix(F,v,o)),HorizontalJoin(RandomMatrix(F,o,v),ZeroMatrix(F,o))):j in [1..d]]:i in [1..m]];
	Q:=[[(Q[i,j]+Transpose(Q[i,j]))*2^(-1):j in [1..d]]:i in [1..m]];

	P:=[];
	for i in [1..m] do
		H:=0;
		for a in [1..d] do
			for b in [1..d] do
				for c in [1..d] do
					A:=Transpose(S[a])*Q[i,b]*S[c];
					B:=qrmat(f,a+b+c);
					C:=&+[A[x,y]*R.x*R.y:x in [1..n],y in [1..n]];
					D:=&+[B[x,y]*R.(n+x)*R.(n+y):x in [1..d],y in [1..d]];
					H:=H+C*D;
				end for;
			end for;
		end for;
		Append(~P,H-Random(F));
	end for;

	return P;
end function;

function guess(P,n,d,k1,k2)
	R:=Parent(P[1]);
	F:=BaseRing(R);
	T:=PolynomialRing(F,n-k1+d-k2);
	u1:=[Random(F):i in [1..k1]];
	u2:=[Random(F):i in [1..k2]];
	u:=[T.i:i in [1..n-k1]] cat u1 cat [T.(n-k1+i):i in [1..d-k2]] cat u2;
	return [[Evaluate(f,u):f in P],u1,u2];
end function;

function cplx(n,d,m,p,d1,d2)
	P:=[[i,j]:i in [1..n-1],j in [1..d-1]|m-1 eq n+d-i-j];
	Q:=[];
	for a in P do
		for i in [1..d1] do
            for j in [1..d2] do
                if bcf(n-a[1],d-a[2],m,i,j) le 0 and bcf(n-a[1],d-a[2],m,i+1,j+1) le 0 and bcf(n-a[1],d-a[2],m,i,j+1) le 0 and bcf(n-a[1],d-a[2],m,i+1,j) le 0 then
                	b:=Ceiling(2*(Log(2,Binomial(n-a[1]+i,i))+Log(2,Binomial(d-a[2]+j,j)))+Log(2,p)+Log(2,3*Binomial(n-a[1]+2,2)*Binomial(d-a[2]+2,2)));
                    Append(~Q,[a[1],a[2],i,j,b]);
                end if;
            end for;
        end for;
	end for;
	Sort(~Q,func<a,b|a[5]-b[5]>);
	return Q;
end function;

procedure xlsolve(P,n,d,m,p)
	print "The suitable solving degrees are:";
	A:=cplx(n,d,m,p,20,20);
	for i in [1..Minimum(#A,5)] do
		printf "k1=%o\t k2=%o\t d1=%o\t d2=%o\t Complexity=%o\n",A[i,1],A[i,2],A[i,3],A[i,4],A[i,5];
	end for;
	print "Enter k1, k2, d1, and d2 separated by spaces:";
	I:=Open("/dev/stdin", "r");
	s:=Trim(Gets(I));
	if s eq "EOF" then
		error "Expected four solving-degree integers.";
	end if;
	B:=Split(s, " ");
	if #B ne 4 then
		error "Expected four solving-degree integers separated by spaces.";
	end if;
	B:=[StringToInteger(x):x in B];
	for i in [1..2*p] do
		Q:=guess(P,n,d,B[1],B[2]);
		M:=mac(Q[1],n-B[1],d-B[2],B[3],B[4]);
		if GroebnerBasis(Q[1]) ne [1] and Binomial(n-B[1]+B[3],B[3])*Binomial(d-B[2]+B[4],B[4])-Rank(M) eq 1 then
			K:=Basis(NullspaceOfTranspose(M));
			X:=[K[1,i]:i in [2..n-B[1]+1]] cat Q[2];
			Y:=[K[1,i]:i in [n-B[1]+2..n-B[1]+d-B[2]+1]] cat Q[3];
			for j in [1..n] do
				printf "x%o=%o\n",j,X[j];
			end for;
			for j in [1..d] do
				printf "y%o=%o\n",j,Y[j]; 
			end for;
			break;
		end if;
	end for;
end procedure;